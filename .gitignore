# Golden outputs are regenerable (see tools/golden/README.md). Only the manifest is tracked.
tests/golden/prototype/*/
!tests/golden/prototype/manifest.json

__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.DS_Store
.env*
*.egg-info/
build/
dist/

# Context golden summaries are derived from sample data: regenerable, not tracked (manifest only).
tests/golden/context/*.json
!tests/golden/context/manifest.json
